+            _stack_node.node_y = _stack_cursor_y;
+            _stack_node.x = _stack_x;
+            _stack_node.y = _stack_cursor_y;
+            _stack_cursor_y += _stack_node.node_height;
+            _stack_index += 1;
+        }
