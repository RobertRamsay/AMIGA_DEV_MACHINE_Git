diff --git a/scripts/scr_set_status_message/scr_set_status_message.gml b/scripts/scr_set_status_message/scr_set_status_message.gml
new file mode 100644
index 0000000..3f3bcd5
--- /dev/null
+++ b/scripts/scr_set_status_message/scr_set_status_message.gml
@@ -0,0 +1,6 @@
+/// @desc scr_set_status_message(_text)
+/// Sets the reusable status/hint text drawn at the bottom of the screen.
+/// Pass "" to clear it.
+function scr_set_status_message(_text) {
+    global.status_message = _text;
+}
