+    _org_cursor_y += _sprite_macro_node.node_height;
+
+    var _nop_node = instance_create_layer(_org_instance.node_x, _org_cursor_y, "Instances", obj_opcode_node);
+    _nop_node.node_x = _org_instance.node_x;
