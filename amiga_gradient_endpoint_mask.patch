diff --git a/objects/obj_bitmap_editor/Draw_0.gml b/objects/obj_bitmap_editor/Draw_0.gml
index 47390a1..4d8ed5a 100644
--- a/objects/obj_bitmap_editor/Draw_0.gml
+++ b/objects/obj_bitmap_editor/Draw_0.gml
@@ -183,6 +183,21 @@ while (_gradient_slot < 12) {
     draw_rectangle(_gradient_slot_x, _layout.gradient_custom_slots_y,
         _gradient_slot_x + _layout.gradient_custom_slot_width, _layout.gradient_custom_slots_y + _layout.gradient_custom_slot_height, true);
 
+    // Slots after the RMB endpoint are outside the active gradient run.
+    // Keep their stored colours visible underneath, but clearly cross them out.
+    if (_gradient_slot >= bitmap_gradient_custom_count) {
+        draw_set_alpha(0.6);
+        draw_set_colour(c_black);
+        draw_rectangle(_gradient_slot_x + 1, _layout.gradient_custom_slots_y + 1,
+            _gradient_slot_x + _layout.gradient_custom_slot_width - 1,
+            _layout.gradient_custom_slots_y + _layout.gradient_custom_slot_height - 1, false);
+        draw_set_alpha(1);
+        draw_set_colour(c_red);
+        draw_line_width(_gradient_slot_x + 2, _layout.gradient_custom_slots_y + 2,
+            _gradient_slot_x + _layout.gradient_custom_slot_width - 2,
+            _layout.gradient_custom_slots_y + _layout.gradient_custom_slot_height - 2, 2);
+    }
+
     _gradient_slot += 1;
 }
 
